<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/board_bg"
    android:padding="12dp">

    <!-- Top bar: logo (tap for My Drawings) + Save / Share -->
    <LinearLayout
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingEnd="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/appLogoIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_logo_palette"
            android:contentDescription="My Drawings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/topActionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/appTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1">

        <LinearLayout
            android:id="@+id/topActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMore"
                style="@style/TopPillButton"
                android:drawableStart="@drawable/ic_more"
                android:drawablePadding="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="" />

            <TextView
                android:id="@+id/btnSave"
                style="@style/TopPillButton"
                android:drawableStart="@drawable/ic_save"
                android:drawablePadding="6dp"
                android:text="Save" />

            <TextView
                android:id="@+id/btnShare"
                style="@style/TopPillButton"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="6dp"
                android:text="Share" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Left panel: colors + brush size -->
    <ScrollView
        android:id="@+id/leftPanel"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_panel"
        android:elevation="3dp"
        android:padding="12dp"
        android:layout_marginTop="14dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topActionsScroll"
        app:layout_constraintBottom_toTopOf="@id/toolStrip"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/colorsPanelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Colors"
                    android:layout_marginBottom="10dp" />

                <GridLayout
                    android:id="@+id/colorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="My Colors"
                    android:layout_marginBottom="10dp" />

                <GridLayout
                    android:id="@+id/customColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="Brush Size"
                    android:layout_marginBottom="8dp" />

                <SeekBar
                    android:id="@+id/brushSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_segment_container"
                    android:layout_marginTop="8dp">

                    <TextView android:id="@+id/sizeSmall" style="@style/SizePreset" android:text="S" />
                    <View android:layout_width="1dp" android:layout_height="18dp" android:background="@color/divider" />
                    <TextView android:id="@+id/sizeMedium" style="@style/SizePreset" android:text="M" />
                    <View android:layout_width="1dp" android:layout_height="18dp" android:background="@color/divider" />
                    <TextView android:id="@+id/sizeLarge" style="@style/SizePreset" android:text="L" />
                    <View android:layout_width="1dp" android:layout_height="18dp" android:background="@color/divider" />
                    <TextView android:id="@+id/sizeXL" style="@style/SizePreset" android:text="XL" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/textOptionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Text Options"
                    android:layout_marginBottom="14dp" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="Font"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/fontSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="Text Size"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/textSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="30" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="Text Color"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp" />

                <GridLayout
                    android:id="@+id/textColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <TextView
                    android:id="@+id/textToolHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tap anywhere on the canvas to place your text."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/btnExitTextMode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_accent"
                    android:gravity="center"
                    android:text="Done"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Drawing canvas -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_panel"
        android:elevation="3dp"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/topActionsScroll"
        app:layout_constraintBottom_toTopOf="@id/toolStrip"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <com.mom.privatedrawing.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/canvas_bg" />
    </FrameLayout>

    <!-- Bottom tool strip -->
    <HorizontalScrollView
        android:id="@+id/toolStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="3dp"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/toolStripInner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
